{
  "name": "@minotaur_sales/n8n-nodes-minotaur-sales",
  "version": "0.2.5",
  "publishConfig": {
    "access": "public"
  },
  "description": "n8n nodes for integration with Minotaur sales",
  "license": "MIT",
  "homepage": "",
  "keywords": [
    "n8n-community-node-package"
  ],
  "author": {
    "name": "Minotaur sales",
    "email": "minotaur@minotaurcrm.com"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MINOTAUR-LLC/n8n-nodes-minotaur-sales.git"
  },
  "scripts": {
    "build": "n8n-node build",
    "build:watch": "tsc --watch",
    "dev": "n8n-node dev",
    "lint": "n8n-node lint",
    "lint:fix": "n8n-node lint --fix",
    "release": "n8n-node release",
    "prepublishOnly": "n8n-node prerelease"
  },
  "files": [
    "dist"
  ],
  "n8n": {
    "n8nNodesApiVersion": 1,
    "strict": true,
    "credentials": [
      "dist/credentials/MinotaurApi.credentials.js"
    ],
    "nodes": [
      "dist/nodes/Minotaur/Minotaur.node.js"
    ]
  },
  "devDependencies": {
    "@n8n/node-cli": "*",
    "@types/node": "^25.0.3",
    "@typescript-eslint/parser": "^8.52.0",
    "eslint": "9.32.0",
    "prettier": "3.6.2",
    "release-it": "^19.0.4",
    "typescript": "5.9.2"
  },
  "peerDependencies": {
    "n8n-workflow": "*"
  }
}
